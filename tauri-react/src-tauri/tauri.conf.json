{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenHarness",
  "version": "0.1.9",
  "identifier": "com.openharness.desktop",
  "bundle": {
    "publisher": "Lanx",
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "OpenHarness",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src http: https: data:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://openrouter.ai https://generativelanguage.googleapis.com http://localhost:11434 http://127.0.0.1:11434 https://github.com https://*.githubusercontent.com; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QUM1NDA4MDFDNTBENjEKUldSaERjVUJDRlNzVlIyV1FEQ05VR1FoYlMwNjhCaEtBSkZNSzhPYURsci9ndmpaK3ZKYjNEc0MK",
      "endpoints": ["https://github.com/Lanx10/OpenHarness/releases/latest/download/latest.json"]
    }
  }
}
